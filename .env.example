# PostHog project token and ingestion host (the browser reads these public values via /api/config)
POSTHOG_PROJECT_TOKEN=phc_your_project_token
POSTHOG_HOST=https://us.i.posthog.com

# EasyPost carrier tracking (server-only; never expose these in browser config)
EASYPOST_API_KEY=EZAK_your_production_api_key
EASYPOST_WEBHOOK_SECRET=generate_a_long_random_secret
DASHBOARD_ORIGIN=https://your-production-domain.example

# Scheduled reconciliation uses the same CRON_SECRET as the other Vercel cron jobs.
CRON_SECRET=generate_a_different_long_random_secret
